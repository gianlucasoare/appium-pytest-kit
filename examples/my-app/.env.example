# Copy this file to .env and fill in your values
# Run: cp .env.example .env

# ── Platform ───────────────────────────────────────────────
APP_PLATFORM=android
# APP_PLATFORM=ios

# ── Appium server ──────────────────────────────────────────
APP_APPIUM_URL=http://127.0.0.1:4723
APP_MANAGE_APPIUM_SERVER=false

# ── Device ─────────────────────────────────────────────────
APP_DEVICE_NAME=emulator-5554
APP_PLATFORM_VERSION=13
# APP_UDID=your-physical-device-udid

# ── App (Android) ──────────────────────────────────────────
APP_APP_PACKAGE=com.example.myapp
APP_APP_ACTIVITY=.MainActivity

# ── App (iOS) — uncomment and fill if using iOS ────────────
# APP_BUNDLE_ID=com.example.myapp

# ── App binary (optional — skip if app is already installed)
# APP_APP=/path/to/app.apk
# APP_APP=/path/to/app.ipa

# ── Session behaviour ──────────────────────────────────────
APP_NO_RESET=true
APP_NEW_COMMAND_TIMEOUT=120
APP_IMPLICIT_WAIT=0.0

# ── Extra capabilities (JSON) ──────────────────────────────
APP_CAPABILITIES_JSON={}

# ── Reporting ──────────────────────────────────────────────
APP_REPORTING_ENABLED=false
